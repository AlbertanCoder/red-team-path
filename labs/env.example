# Settings for Microsoft's AI Red Teaming labs. Copy this file into the labs folder and name the copy  .env
# 1. Paste your OpenAI key after the equals sign, with no spaces and no quotes. Keep it private.
OPENAI_API_KEY=PASTE_YOUR_KEY_HERE
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
# 2. Replace both values below with long random letters and numbers of your own (32 characters is plenty).
#    The labs use them to sign you in. Anyone who has AUTH_KEY can open your labs page, so do not share it.
AUTH_KEY=REPLACE_WITH_RANDOM_LETTERS_AND_NUMBERS
SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_LETTERS_AND_NUMBERS
