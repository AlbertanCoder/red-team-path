{
  "rules": {
    ".read": false,
    ".write": false,
    "sync": {
      "$code": {
        ".read": "$code.matches(/^[a-z2-9]{32}$/)",
        ".write": "$code.matches(/^[a-z2-9]{32}$/)",
        ".validate": "newData.hasChildren()",
        "m": {
          ".validate": "newData.hasChildren() && newData.numChildren() <= 2000",
          "$id": {
            ".validate": "$id.matches(/^[a-z][a-z0-9]{0,23}$/) && newData.isNumber() && newData.val() <= now + 604800000 && newData.val() >= -(now + 604800000)"
          }
        },
        "y": {
          ".validate": "newData.hasChildren() && newData.numChildren() <= 2000",
          "$day": {
            ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 604800000"
          }
        },
        "r": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= now + 604800000" },
        "b": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "$other": { ".validate": false }
      }
    },
    "pair": {
      "$pin": {
        ".read": "$pin.matches(/^[a-z2-9]{8}$/) && data.exists() && data.child('t').val() > now - 600000",
        ".write": "$pin.matches(/^[a-z2-9]{8}$/) && (!data.exists() || !newData.exists())",
        ".validate": "newData.hasChildren(['c', 't'])",
        "c": { ".validate": "newData.isString() && newData.val().matches(/^[a-z2-9]{32}$/)" },
        "t": { ".validate": "newData.val() == now" },
        "$other": { ".validate": false }
      }
    }
  }
}
